---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import HeroShader from '../components/HeroShader.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import TerrainSampler from '../components/TerrainSampler.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, site, type Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const projects = (await getCollection('projects')).filter((project) => project.data.featured).slice(0, 3);
const capabilityIcons: Record<string, string> = {
  'ML / GeoAI': 'capabilities/geoai',
  Geoespacial: 'capabilities/map',
  Teledetección: 'capabilities/satellite',
  'Nubes de puntos / 3D': 'capabilities/cube',
  'Ingeniería de datos': 'capabilities/database',
  'Web / Visualización': 'capabilities/browser',
  Infraestructura: 'capabilities/server',
  Geospatial: 'capabilities/map',
  'Remote Sensing': 'capabilities/satellite',
  'Point Clouds / 3D': 'capabilities/cube',
  'Data Engineering': 'capabilities/database',
  'Web / Visualization': 'capabilities/browser',
  Infrastructure: 'capabilities/server',
};
const technologyIcons: Record<string, string> = {
  Python: 'logos:python', PyTorch: 'logos:pytorch-icon', 'scikit-learn': 'capabilities/geoai',
  MLflow: 'capabilities/geoai', OpenCV: 'logos:opencv',
  GDAL: 'capabilities/map', Rasterio: 'capabilities/map', QGIS: 'capabilities/map', GeoPandas: 'capabilities/map', PostGIS: 'logos:postgresql',
  'Sentinel-2': 'capabilities/satellite', STAC: 'capabilities/satellite', 'Planetary Computer': 'capabilities/satellite', Copernicus: 'capabilities/satellite',
  Open3D: 'capabilities/cube', CloudCompare: 'capabilities/cube', Cesium: 'capabilities/cube', Potree: 'capabilities/cube',
  SQL: 'capabilities/database', PostgreSQL: 'logos:postgresql', Airflow: 'logos:airflow-icon', Docker: 'logos:docker-icon',
  TypeScript: 'logos:typescript-icon', Astro: 'logos:astro-icon', WebGL: 'capabilities/browser', CesiumJS: 'capabilities/cube', OpenLayers: 'logos:openlayers',
  'GitHub Actions': 'logos:github-actions', AWS: 'logos:aws', Linux: 'logos:linux-tux',
};

const copy = locale === 'es' ? {
  description: 'Portfolio de ingeniería geoespacial, machine learning, teledetección y visualización 3D.',
  status: 'Disponible para nuevos retos',
  heroA: 'Istaliyan',
  heroB: 'Ivanov Manov',
  intro: 'Diseño sistemas que convierten imágenes, nubes de puntos y datos territoriales en productos fiables, medibles y fáciles de usar.',
  seeProjects: 'Explorar proyectos',
  profileLabel: 'Perfil / 02',
  profileMatrixTitle: 'Stack tecnológico',
  capabilityColumns: ['Stack principal', 'Herramientas de apoyo'],
  capabilities: [
    ['ML / GeoAI', 'Python, PyTorch, scikit-learn', 'MLflow, OpenCV', '3 proyectos'],
    ['Geoespacial', 'GDAL, Rasterio, QGIS', 'GeoPandas, PostGIS', '6 proyectos'],
    ['Teledetección', 'Sentinel-2, STAC', 'Planetary Computer, Copernicus', '4 proyectos'],
    ['Nubes de puntos / 3D', 'Open3D, CloudCompare', 'Cesium, Potree', '3 proyectos'],
    ['Ingeniería de datos', 'Python, SQL, PostgreSQL', 'Airflow, Docker', '4 proyectos'],
    ['Web / Visualización', 'TypeScript, Astro, WebGL', 'CesiumJS, OpenLayers', '3 proyectos'],
    ['Infraestructura', 'Docker, GitHub Actions', 'AWS, Linux', '5 proyectos'],
  ],
  workLabel: 'Trabajo / 01',
  workTitle: 'Proyectos destacados',
  allProjects: 'Ver todos los proyectos',
  collaborationLabel: 'Colaboración / 03',
  collaborationTitle: '¿Trabajamos juntos?',
  collaborationBody: 'Colaboro en proyectos de ingeniería geoespacial, machine learning, teledetección y visualización.',
  collaborationEmail: 'Escríbeme',
} : {
  description: 'Portfolio spanning geospatial engineering, machine learning, remote sensing, and 3D visualization.',
  status: 'Open to new challenges',
  heroA: 'Istaliyan',
  heroB: 'Ivanov Manov',
  intro: 'I design systems that turn imagery, point clouds, and territorial data into reliable, measurable, and usable products.',
  seeProjects: 'Explore projects',
  profileLabel: 'Profile / 02',
  profileMatrixTitle: 'Tech stack',
  capabilityColumns: ['Core stack', 'Supporting tools'],
  capabilities: [
    ['ML / GeoAI', 'Python, PyTorch, scikit-learn', 'MLflow, OpenCV', '3 projects'],
    ['Geospatial', 'GDAL, Rasterio, QGIS', 'GeoPandas, PostGIS', '6 projects'],
    ['Remote Sensing', 'Sentinel-2, STAC', 'Planetary Computer, Copernicus', '4 projects'],
    ['Point Clouds / 3D', 'Open3D, CloudCompare', 'Cesium, Potree', '3 projects'],
    ['Data Engineering', 'Python, SQL, PostgreSQL', 'Airflow, Docker', '4 projects'],
    ['Web / Visualization', 'TypeScript, Astro, WebGL', 'CesiumJS, OpenLayers', '3 projects'],
    ['Infrastructure', 'Docker, GitHub Actions', 'AWS, Linux', '5 projects'],
  ],
  workLabel: 'Work / 01',
  workTitle: 'Selected projects',
  allProjects: 'View all projects',
  collaborationLabel: 'Collaboration / 03',
  collaborationTitle: 'Let’s work together.',
  collaborationBody: 'I collaborate on projects in geospatial engineering, machine learning, remote sensing, and visualization.',
  collaborationEmail: 'Email me',
};
---

<BaseLayout locale={locale} description={copy.description}>
  <section class="hero-shell">
    <HeroShader />
    <div class="hero page-shell">
      <div class="hero-copy">
        <div class="eyebrow">{copy.status}</div>
        <h1 class="display-title">{copy.heroA}<br /><em>{copy.heroB}</em></h1>
        <p class="lede">{copy.intro}</p>
        <div class="hero-actions">
          <a class="button-primary" href={localePath(locale, '/projects')}>{copy.seeProjects}<span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <TerrainSampler locale={locale} />
      <div class="hero-foot"><span>PORTFOLIO / 2026</span><span>SCROLL ↓</span></div>
    </div>
  </section>

  <section class="section-pad rule work-section">
    <div class="page-shell">
      <div class="projects-head">
        <p class="eyebrow">{copy.workLabel}</p>
        <h2 class="section-title">{copy.workTitle}</h2>
      </div>
      <ProjectGrid projects={projects} locale={locale} />
      <div class="projects-more">
        <a class="text-link" href={localePath(locale, '/projects')}>{copy.allProjects}<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section-pad rule">
    <div class="page-shell profile-section">
      <p class="eyebrow">{copy.profileLabel}</p>
      <h2 class="profile-matrix-title">{copy.profileMatrixTitle}</h2>
      <div class="profile-capabilities">
        {copy.capabilities.map(([area, core, supporting, evidence]) => (
          <article>
            <div class="capability-heading">
              <Icon class="capability-icon" name={capabilityIcons[area]} size="1.3rem" aria-hidden="true" focusable="false" />
              <h3>{area}</h3>
            </div>
            <dl>
              <div><dt>{copy.capabilityColumns[0]}</dt><dd class="technology-chips">{core.split(', ').map((technology) => <span><Icon class="technology-icon" name={technologyIcons[technology]} size="0.75rem" aria-hidden="true" focusable="false" />{technology}</span>)}</dd></div>
              <div><dt>{copy.capabilityColumns[1]}</dt><dd class="technology-chips technology-chips--supporting">{supporting.split(', ').map((technology) => <span><Icon class="technology-icon" name={technologyIcons[technology]} size="0.75rem" aria-hidden="true" focusable="false" />{technology}</span>)}</dd></div>
            </dl>
            <div class="capability-evidence" aria-label={evidence}>
              <div class="evidence-scale" aria-hidden="true">
                {Array.from({ length: 6 }, (_, index) => <i class:list={{ active: index < Number(evidence.match(/\d+/)?.[0]) }}></i>)}
              </div>
              <span>{evidence}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad collaboration-section">
    <div class="page-shell collaboration-grid">
      <div class="collaboration-copy">
        <p class="eyebrow">{copy.collaborationLabel}</p>
        <h2 class="section-title">{copy.collaborationTitle}</h2>
        <p>{copy.collaborationBody}</p>
      </div>
      <a class="collaboration-email" href={`mailto:${site.email}`}>
        <span>{copy.collaborationEmail}</span>
        <strong>{site.email}</strong>
        <span class="collaboration-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-shell { position: relative; isolation: isolate; overflow: hidden; }
  .hero { position: relative; z-index: 1; display: grid; min-height: min(47rem, calc(100vh - 4.75rem)); grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.58fr); align-items: center; gap: clamp(2.5rem, 6vw, 6rem); padding-block: 3.5rem 3rem; }
  .hero-copy { position: relative; z-index: 2; }
  .hero h1 { margin-top: 1.25rem; }
  .hero h1 em { color: var(--color-forest); font-weight: 430; }
  .hero .lede { max-width: 37rem; margin: 1.5rem 0 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.7rem; }
  .hero-foot { position: absolute; z-index: 2; right: 0; bottom: 1rem; left: 0; display: flex; justify-content: space-between; color: var(--color-muted); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; }
  .work-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(
      to bottom,
      var(--color-forest) 0%,
      rgba(21, 61, 48, 0.88) 18%,
      rgba(21, 61, 48, 0.34) 46%,
      transparent 74%
    );
  }
  .work-section::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: radial-gradient(circle, rgba(244, 240, 231, 0.34) 0 0.7px, transparent 0.9px);
    background-size: 5px 5px;
    content: "";
    mask-image: linear-gradient(to bottom, black, transparent 58%);
    opacity: 0.22;
    pointer-events: none;
  }
  .profile-section > .eyebrow { width: min(100%, 64rem); justify-content: center; margin: 0 auto 1.5rem; }
  .profile-matrix-title { margin: 0 auto 2.5rem; color: var(--color-forest); font-family: var(--font-serif); font-size: clamp(1.55rem, 3.3vw, 2.5rem); font-weight: 480; letter-spacing: -0.04em; line-height: 1; text-align: center; white-space: nowrap; }
  .profile-capabilities { width: min(100%, 64rem); margin-inline: auto; border-top: 1px solid var(--color-forest); }
  .profile-capabilities article { display: grid; grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.6fr) auto; align-items: center; gap: 1.5rem; padding-block: 1rem; border-bottom: 1px solid var(--color-line); transition: background-color 180ms ease, padding-inline 180ms ease; }
  .profile-capabilities article:hover { padding-inline: 0.65rem; background: color-mix(in srgb, var(--color-forest) 5%, transparent); }
  .capability-heading { display: flex; align-items: center; gap: 0.6rem; }
  :global(.capability-icon) { flex: none; color: color-mix(in srgb, var(--color-forest) 58%, transparent); transition: color 180ms ease; }
  .profile-capabilities article:hover :global(.capability-icon) { color: var(--color-forest); }
  .profile-capabilities h3 { margin: 0; color: var(--color-forest); font-family: var(--font-serif); font-size: 1.3rem; font-weight: 520; letter-spacing: -0.025em; }
  .profile-capabilities dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin: 0; }
  .profile-capabilities dl div { min-width: 0; }
  .profile-capabilities dt { margin-bottom: 0.25rem; color: var(--color-forest-light); font-size: 0.56rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .profile-capabilities dd { margin: 0; color: var(--color-muted); font-size: 0.76rem; line-height: 1.5; }
  .technology-chips { display: flex; flex-wrap: wrap; gap: 0.32rem; }
  .technology-chips > span { display: inline-flex; flex-flow: row nowrap; align-items: center; justify-content: flex-start; gap: 0.28rem; padding: 0.19rem 0.38rem; color: var(--color-forest); font-size: 0.66rem; line-height: 1.25; white-space: nowrap; }
  :global(.technology-icon) { display: block; flex: 0 0 auto; opacity: 0.58; filter: brightness(0) saturate(100%) invert(20%) sepia(24%) saturate(1360%) hue-rotate(109deg) brightness(92%) contrast(91%); transition: opacity 180ms ease; }
  .profile-capabilities article:hover :global(.technology-icon) { opacity: 1; }
  .technology-chips--supporting > span { color: var(--color-muted); }
  .capability-evidence { display: grid; justify-items: end; gap: 0.35rem; color: var(--color-signal); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; white-space: nowrap; }
  .evidence-scale { display: flex; gap: 0.18rem; }
  .evidence-scale i { display: block; width: 0.85rem; height: 0.16rem; background: var(--color-line); }
  .evidence-scale i.active { background: var(--color-signal); }
  .projects-head { margin-bottom: 2.8rem; text-align: center; }
  .projects-head .eyebrow { justify-content: center; margin: 0 0 1rem; color: color-mix(in srgb, var(--color-paper) 72%, transparent); }
  .projects-head .eyebrow::before { background: var(--color-signal); }
  .projects-head .section-title { max-width: none; margin-inline: auto; color: var(--color-paper); font-size: clamp(1.7rem, 4vw, 3.3rem); white-space: nowrap; }
  .projects-more { display: flex; justify-content: center; margin-top: 2.2rem; }
  .text-link { display: flex; align-items: center; gap: 1rem; color: var(--color-forest); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 0.3rem; }
  .collaboration-section { padding-block: clamp(2.5rem, 4vw, 3.5rem); background-color: var(--color-forest); color: var(--color-paper); }
  .collaboration-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(19rem, 22rem); align-items: center; gap: clamp(2.5rem, 7vw, 7rem); }
  .collaboration-copy .eyebrow { margin: 0 0 0.85rem; color: color-mix(in srgb, var(--color-paper) 68%, transparent); font-size: 0.6rem; }
  .collaboration-copy .section-title { max-width: none; color: var(--color-paper); font-size: clamp(1.65rem, 2.8vw, 2.45rem); }
  .collaboration-copy > p:last-child { max-width: 39rem; margin: 0.8rem 0 0; color: color-mix(in srgb, var(--color-paper) 70%, transparent); font-size: 0.82rem; line-height: 1.65; }
  .collaboration-email { position: relative; display: grid; gap: 0.45rem; padding: 1rem 3rem 1rem 1rem; border: 1px solid color-mix(in srgb, var(--color-paper) 28%, transparent); color: var(--color-paper); text-decoration: none; transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease; }
  .collaboration-email::before { position: absolute; top: -1px; left: 1rem; width: 2.2rem; height: 1px; background: var(--color-signal); content: ""; }
  .collaboration-email > span:first-child { color: color-mix(in srgb, var(--color-paper) 62%, transparent); font-size: 0.55rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
  .collaboration-email strong { overflow-wrap: anywhere; font-family: var(--font-serif); font-size: clamp(1rem, 1.7vw, 1.3rem); font-weight: 480; letter-spacing: -0.02em; }
  .collaboration-arrow { position: absolute; top: 50%; right: 1rem; color: var(--color-signal); font-size: 1rem; transform: translateY(-50%); }
  .collaboration-email:hover { border-color: var(--color-paper); background: color-mix(in srgb, var(--color-paper) 8%, transparent); transform: translateY(-2px); }
  @media (max-width: 900px) {
    .hero { min-height: auto; grid-template-columns: 1fr; }
  }
  @media (max-width: 650px) {
    .collaboration-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .collaboration-email { width: 100%; }
    .profile-capabilities article { grid-template-columns: 1fr auto; gap: 1rem; }
    .profile-capabilities dl { grid-column: 1 / -1; grid-row: 2; }
    .capability-evidence { grid-column: 2; grid-row: 1; }
  }
  @media (max-width: 520px) {
    .profile-capabilities dl { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
