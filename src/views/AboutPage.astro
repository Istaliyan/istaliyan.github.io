---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import portrait from '../assets/profile/about-portrait.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThingsILikeGraph from '../components/ThingsILikeGraph.astro';
import { site, type Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const portraitAlt = locale === 'es'
  ? 'Retrato de Istaliyan Ivanov Manov al aire libre'
  : 'Portrait of Istaliyan Ivanov Manov outdoors';
const copy = locale === 'es' ? {
  title: 'Sobre mí',
  intro: 'Soy un perfil técnico especializado en construir sistemas donde el territorio, los datos y el software tienen que entenderse entre sí.',
  storyTitle: 'Más allá del modelo.',
  story: ['Mi trabajo empieza antes del entrenamiento: entender cómo se capturó el dato, qué representa realmente y dónde puede romperse el razonamiento espacial.', 'Después convierto ese conocimiento en pipelines reproducibles, modelos medibles y herramientas que hacen visible el resultado. El objetivo es que una solución no solo funcione una vez, sino que pueda explicarse, mantenerse y evolucionar.'],
  contactLabel: 'Contáctame en:',
  emailLabel: 'Correo',
  interestsLabel: 'Intereses / 02',
  interestsTitle: 'Cosas que me interesan',
  interestsBody: 'Un mapa de las disciplinas técnicas y culturales que conectan mi forma de construir software: desde los fundamentos de informática y los sistemas de ML hasta los datos geoespaciales, la estética y la literatura.',
  interestsAria: 'Grafo interactivo de intereses en informática, inteligencia artificial, ingeniería de software, datos geoespaciales, estética y literatura',
} : {
  title: 'About',
  intro: 'I am a technical specialist focused on building systems where territory, data, and software need to understand each other.',
  storyTitle: 'Beyond the model.',
  story: ['My work starts before training: understanding how data was captured, what it truly represents, and where spatial reasoning can break.', 'I then turn that knowledge into reproducible pipelines, measurable models, and tools that make outcomes visible. The goal is not only to make a solution work once, but to make it explainable, maintainable, and able to evolve.'],
  contactLabel: 'Contact me on:',
  emailLabel: 'Email',
  interestsLabel: 'Interests / 02',
  interestsTitle: 'Things I am interested in',
  interestsBody: 'A map of the technical and cultural disciplines that shape how I build software: from computer science fundamentals and ML systems to geospatial data, aesthetics, and literature.',
  interestsAria: 'Interactive graph of interests in computer science, artificial intelligence, software engineering, geospatial data, aesthetics, and literature',
};
---

<BaseLayout locale={locale} title={copy.title} description={copy.intro}>
  <section class="section-pad story-section paper-texture">
    <div class="page-shell story-grid">
      <figure class="portrait blueprint-card">
        <Image src={portrait} alt={portraitAlt} layout="full-width" />
      </figure>
      <div class="story-copy">
        <p class="eyebrow">BIO / A—01</p>
        <h2 class="section-title">{copy.storyTitle}</h2>
        <p>{copy.intro}</p>
        {copy.story.map((paragraph) => <p>{paragraph}</p>)}
        <div class="story-contact">
          <span>{copy.contactLabel}</span>
          <div class="story-contact-links">
            <a href={site.linkedin}>
              <Icon name="brands/linkedin" size="0.95rem" aria-hidden="true" focusable="false" />
              <span>LinkedIn</span>
            </a>
            <a href={`mailto:${site.email}`}>
              <Icon name="envelope" size="0.95rem" aria-hidden="true" focusable="false" />
              <span>{copy.emailLabel}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad rule interests-section">
    <div class="page-shell">
      <div class="interests-head">
        <div>
          <p class="eyebrow">{copy.interestsLabel}</p>
          <h2 class="section-title">{copy.interestsTitle}</h2>
        </div>
        <p>{copy.interestsBody}</p>
      </div>
      <ThingsILikeGraph ariaLabel={copy.interestsAria} locale={locale} rootLabel={copy.interestsTitle} />
    </div>
  </section>
</BaseLayout>

<style>
  .story-section { border-bottom: 1px solid #123e32; }
  .story-grid { display: grid; grid-template-columns: minmax(19rem, 0.8fr) 1.2fr; align-items: stretch; gap: clamp(3rem, 9vw, 9rem); }
  .portrait { min-height: 27rem; margin: 0; overflow: hidden; border-color: rgba(244, 240, 231, 0.35); background: var(--color-forest); }
  .portrait::before, .portrait::after { border-color: var(--color-paper); }
  .portrait :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .story-copy { display: flex; flex-direction: column; }
  .story-copy > .eyebrow { justify-content: center; color: rgba(244, 240, 231, 0.78); }
  .story-copy h2 { max-width: none; margin: 1.5rem 0 2rem; color: var(--color-paper); text-align: center; white-space: nowrap; }
  .story-copy > p:not(.eyebrow) { margin: 0 0 1.2rem; color: rgba(244, 240, 231, 0.86); font-size: 1rem; line-height: 1.85; }
  .story-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: auto; padding-top: 1.25rem; border-top: 1px solid rgba(244, 240, 231, 0.35); }
  .story-contact > span { color: rgba(244, 240, 231, 0.78); font-size: 0.72rem; font-weight: 700; }
  .story-contact-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .story-contact-links a { display: inline-flex; min-height: 2.1rem; align-items: center; gap: 0.45rem; padding: 0.5rem 0.7rem; border: 1px solid rgba(244, 240, 231, 0.4); color: var(--color-paper); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.05em; line-height: 1; text-decoration: none; text-transform: uppercase; transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease; }
  .story-contact-links :global(svg) { flex: none; }
  .story-contact-links a:hover { border-color: var(--color-paper); background: var(--color-paper); color: #123e32; }
  .interests-section { background: color-mix(in srgb, var(--color-paper-deep) 34%, transparent); }
  .interests-head { display: grid; grid-template-columns: 1fr; gap: 1.25rem; margin-bottom: 2rem; }
  .interests-head .eyebrow { justify-content: center; margin: 0 0 1.2rem; }
  .interests-head .section-title { max-width: none; text-align: center; white-space: nowrap; }
  .interests-head > p { max-width: 42rem; margin: 0 auto; color: var(--color-muted); font-size: 0.88rem; line-height: 1.75; text-align: center; }
  @media (max-width: 760px) {
    .story-grid { grid-template-columns: 1fr; }
    .portrait { height: 24rem; min-height: 0; }
    .story-contact { margin-top: 1.5rem; }
  }
  @media (max-width: 520px) {
    .story-copy .section-title,
    .interests-head .section-title { font-size: clamp(1.6rem, 7vw, 2rem); }
  }
</style>
