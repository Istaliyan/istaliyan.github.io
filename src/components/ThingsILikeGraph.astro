---
import type { EChartsOption } from 'echarts';
import type { Locale } from '../lib/site';
import EChart from './EChart.astro';

interface Props {
  ariaLabel: string;
  locale: Locale;
  rootLabel: string;
}

const { ariaLabel, locale, rootLabel } = Astro.props;
const renderTimeLabel = locale === 'es' ? 'El gráfico se ha generado en' : 'Chart has been generated in';

const interestGroupLabels = [
  {
    name: { es: 'Informática', en: 'Computer Science' },
    color: '#153d30',
    topics: [
      { es: 'Algoritmos', en: 'Algorithms' },
      { es: 'Estructuras de datos', en: 'Data Structures' },
      { es: 'Bases de datos', en: 'Databases' },
      { es: 'Sistemas distribuidos', en: 'Distributed Systems' },
      { es: 'Tecnologías web', en: 'Web Technologies' },
      { es: 'Computación gráfica', en: 'Computer Graphics' },
      { es: 'Computación en la nube', en: 'Cloud Computing' },
      { es: 'Rendimiento', en: 'Performance Engineering' },
      { es: 'Diseño de sistemas', en: 'System Design' },
    ],
  },
  {
    name: { es: 'Inteligencia artificial', en: 'Artificial Intelligence' },
    color: '#bd6b43',
    topics: [
      { es: 'Machine learning', en: 'Machine Learning' },
      { es: 'Deep learning', en: 'Deep Learning' },
      { es: 'Visión artificial', en: 'Computer Vision' },
      { es: 'Transformers', en: 'Transformers' },
      { es: 'IA generativa', en: 'Generative AI' },
      { es: 'Aprendizaje de representaciones', en: 'Representation Learning' },
      { es: 'Evaluación de modelos', en: 'Model Evaluation' },
      { es: 'IA explicable', en: 'Explainable AI' },
      { es: 'MLOps', en: 'MLOps' },
      { es: 'Machine learning espacial', en: 'Spatial Machine Learning' },
    ],
  },
  {
    name: { es: 'Software y datos', en: 'Software & Data' },
    color: '#315f68',
    topics: [
      { es: 'Arquitectura de software', en: 'Software Architecture' },
      { es: 'APIs', en: 'APIs' },
      { es: 'Ingeniería de datos', en: 'Data Engineering' },
      { es: 'Pipelines reproducibles', en: 'Reproducible Pipelines' },
      { es: 'Testing automatizado', en: 'Automated Testing' },
      { es: 'CI/CD', en: 'CI/CD' },
      { es: 'Contenedores', en: 'Containers' },
      { es: 'Observabilidad', en: 'Observability' },
      { es: 'Visualización de datos', en: 'Data Visualization' },
    ],
  },
  {
    name: { es: 'Geoespacial y 3D', en: 'Geospatial & 3D' },
    color: '#8c7a4c',
    topics: [
      { es: 'Sistemas de información geográfica', en: 'Geographic Information Systems' },
      { es: 'Teledetección', en: 'Remote Sensing' },
      { es: 'Observación de la Tierra', en: 'Earth Observation' },
      { es: 'Análisis espacial', en: 'Spatial Analysis' },
      { es: 'LiDAR', en: 'LiDAR' },
      { es: 'Nubes de puntos', en: 'Point Clouds' },
      { es: 'Fotogrametría', en: 'Photogrammetry' },
      { es: 'Gemelos digitales', en: 'Digital Twins' },
      { es: 'Visualización 3D', en: '3D Visualization' },
      { es: 'Cartografía interactiva', en: 'Interactive Cartography' },
    ],
  },
  {
    name: { es: 'Estética', en: 'Aesthetics' },
    color: '#6e6952',
    topics: [
      { es: 'Filosofía del arte', en: 'Philosophy of Art' },
      { es: 'Filosofía de la belleza', en: 'Philosophy of Beauty' },
      { es: 'Filosofía del gusto', en: 'Philosophy of Taste' },
      { es: 'Lo sublime', en: 'The Sublime' },
      { es: 'Representación', en: 'Representation' },
      { es: 'Mímesis', en: 'Mimesis' },
      { es: 'Expresión', en: 'Expression' },
      { es: 'Interpretación', en: 'Interpretation' },
      { es: 'Valor artístico', en: 'Artistic Value' },
      { es: 'Formalismo', en: 'Formalism' },
      { es: 'Filosofía de la creatividad', en: 'Philosophy of Creativity' },
      { es: 'Estética cotidiana', en: 'Everyday Aesthetics' },
      { es: 'Estética ambiental', en: 'Environmental Aesthetics' },
    ],
  },
  {
    name: { es: 'Literatura', en: 'Literature' },
    color: '#985a49',
    topics: [
      { es: 'Ana Karenina', en: 'Anna Karenina' },
      { es: 'Pedro Páramo', en: 'Pedro Páramo' },
      { es: 'Austerlitz', en: 'Austerlitz' },
      { es: 'Stoner', en: 'Stoner' },
      { es: 'En busca del tiempo perdido', en: 'In Search of Lost Time' },
      { es: 'Canto a mí mismo', en: 'Song of Myself' },
    ],
  },
] as const;

const interestGroups = interestGroupLabels.map((group) => ({
  name: group.name[locale],
  color: group.color,
  topics: group.topics.map((topic) => topic[locale]),
}));

const categories = interestGroups.map(({ name, color }) => ({
  name,
  itemStyle: { color },
}));

const nodes = [
  {
    id: 'root',
    name: rootLabel,
    symbolSize: 42,
    itemStyle: { color: '#17231d', borderColor: '#f4f0e7', borderWidth: 2 },
    label: { show: true, color: '#17231d', fontSize: 13, fontWeight: 700 },
  },
  ...interestGroups.flatMap((group, category) => [
    {
      id: `category-${category}`,
      name: group.name,
      category,
      symbolSize: 26,
      label: { show: true, fontSize: 11, fontWeight: 700 },
    },
    ...group.topics.map((topic, topicIndex) => ({
      id: `topic-${category}-${topicIndex}`,
      name: topic,
      category,
      symbolSize: 9,
    })),
  ]),
];

const linkCurves = [-0.46, 0.34, -0.3, 0.48, -0.4, 0.26, 0.42, -0.22, 0.38];

const relationshipLinks = [
  ['topic-0-0', 'topic-0-1', 0.42],
  ['topic-0-2', 'topic-0-3', -0.46],
  ['topic-0-3', 'topic-0-6', 0.34],
  ['topic-0-4', 'topic-2-1', -0.38],
  ['topic-0-5', 'topic-3-8', 0.48],
  ['topic-0-8', 'topic-2-0', -0.44],
  ['topic-1-0', 'topic-1-1', 0.38],
  ['topic-1-1', 'topic-1-2', -0.4],
  ['topic-1-3', 'topic-1-4', 0.46],
  ['topic-1-5', 'topic-1-6', -0.32],
  ['topic-1-6', 'topic-1-7', 0.42],
  ['topic-1-6', 'topic-1-8', -0.48],
  ['topic-1-2', 'topic-1-9', 0.3],
  ['topic-2-0', 'topic-2-1', 0.44],
  ['topic-2-2', 'topic-2-3', -0.4],
  ['topic-2-4', 'topic-2-5', 0.36],
  ['topic-2-5', 'topic-2-6', -0.46],
  ['topic-2-7', 'topic-2-8', 0.32],
  ['topic-2-8', 'topic-3-9', -0.42],
  ['topic-3-0', 'topic-3-3', 0.4],
  ['topic-3-1', 'topic-3-2', -0.34],
  ['topic-3-4', 'topic-3-5', 0.48],
  ['topic-3-5', 'topic-3-6', -0.38],
  ['topic-3-7', 'topic-3-8', 0.44],
  ['topic-0-5', 'topic-4-4', -0.34],
  ['topic-1-7', 'topic-4-7', 0.42],
  ['topic-2-8', 'topic-4-4', -0.46],
  ['topic-3-8', 'topic-4-4', 0.36],
  ['topic-3-9', 'topic-4-7', -0.4],
  ['topic-4-0', 'topic-4-4', 0.38],
  ['topic-4-4', 'topic-4-5', -0.32],
  ['topic-4-6', 'topic-4-7', 0.44],
  ['topic-4-9', 'topic-4-10', -0.42],
  ['topic-4-11', 'topic-4-12', 0.34],
  ['topic-5-0', 'topic-5-4', -0.46],
  ['topic-5-1', 'topic-5-2', 0.4],
  ['topic-5-2', 'topic-5-3', -0.36],
  ['topic-5-4', 'topic-5-5', 0.48],
  ['topic-5-2', 'topic-4-7', -0.3],
  ['category-0', 'category-2', -0.32],
  ['category-1', 'category-3', 0.36],
  ['category-3', 'category-4', -0.4],
  ['category-4', 'category-5', 0.44],
] as const;

const hierarchyLinks = interestGroups.flatMap((group, category) => [
  {
    source: 'root',
    target: `category-${category}`,
    lineStyle: { width: 1.25, opacity: 0.38, curveness: category % 2 === 0 ? 0.42 : -0.42 },
  },
  ...group.topics.map((_, topicIndex) => ({
    source: `category-${category}`,
    target: `topic-${category}-${topicIndex}`,
    lineStyle: {
      width: 0.7,
      opacity: 0.24,
      curveness: linkCurves[(topicIndex + category * 2) % linkCurves.length],
    },
  })),
]);

const links = [
  ...hierarchyLinks,
  ...relationshipLinks.map(([source, target, curveness], index) => ({
    source,
    target,
    lineStyle: {
      width: index >= 24 ? 1.1 : 0.95,
      opacity: index >= 24 ? 0.4 : 0.34,
      curveness,
    },
  })),
];

const option: EChartsOption = {
  backgroundColor: 'transparent',
  tooltip: { trigger: 'item' },
  legend: {
    top: 14,
    left: 'center',
    selectedMode: 'multiple',
    data: categories.map(({ name }) => name),
    textStyle: { color: '#667069', fontSize: 11 },
  },
  animationDuration: 900,
  animationDurationUpdate: 900,
  animationEasingUpdate: 'quinticInOut',
  series: [
    {
      type: 'graph',
      layout: 'force',
      top: 58,
      right: 24,
      bottom: 24,
      left: 24,
      data: nodes,
      links,
      categories,
      roam: true,
      draggable: true,
      label: {
        show: true,
        position: 'right',
        distance: 5,
        color: '#3f4d46',
        fontSize: 9,
      },
      labelLayout: { hideOverlap: true },
      lineStyle: {
        color: 'source',
        width: 0.8,
        opacity: 0.3,
        curveness: 0.08,
      },
      itemStyle: {
        borderColor: '#f4f0e7',
        borderWidth: 1.2,
      },
      force: {
        repulsion: 185,
        gravity: 0.08,
        edgeLength: [58, 142],
        friction: 0.65,
      },
      emphasis: {
        focus: 'adjacency',
        label: { show: true, color: '#17231d', fontSize: 11 },
        lineStyle: { width: 2, opacity: 0.8 },
      },
    },
  ],
};
---

<div class="interests-graph">
  <EChart
    option={option}
    ariaLabel={ariaLabel}
    height="clamp(40rem, 72vw, 54rem)"
    renderTimeLabel={renderTimeLabel}
  />
</div>

<style>
  .interests-graph { padding: clamp(0.25rem, 1vw, 0.75rem); overflow: hidden; }
  .interests-graph :global(portfolio-echart) { margin: 0; background: transparent; }
</style>
